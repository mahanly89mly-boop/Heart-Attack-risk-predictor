# Copy to .env for local runs (docker-compose reads this automatically)

PORT=8000

MODEL_PATH=artifacts/model.pkl
ENCODER_PATH=artifacts/OneHotEncoder.pkl
MODEL_VERSION=1.0.0

LOG_DB_PATH=data/monitoring.db

MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=heart-disease-risk-serving
ENABLE_MLFLOW_LOGGING=true

RISK_LOW_MAX=0.3
RISK_MEDIUM_MAX=0.6

ALLOWED_ORIGINS=*
